<Project>

  <PropertyGroup>
    <LangVersion>12.0</LangVersion>

    <!-- .NET Framework 4.8 ships with Windows 10 1903+ and Windows 11, so
         PeripheralBatteryMonitor.exe runs on a clean machine with nothing to
         install. That is the whole reason for this target: no version of Windows
         preinstalls the .NET 5+ runtime, so a framework-dependent modern build
         would fail to launch, and a self-contained one would cost ~150 MB for a
         tray icon.

         It is also the only target that can consume Windows.winmd the way this
         app does — see the WinRT bridging note in CLAUDE.md.

         Never add PublishAot or PublishTrimmed. -->
    <TargetFramework>net48</TargetFramework>

    <Product>PeripheralBatteryMonitor</Product>
    <Company>o0Zz</Company>
    <Copyright>Copyright (c) o0Zz</Copyright>
    <NeutralLanguage>en</NeutralLanguage>

    <!-- Unreleased default. CI overrides all three from `git describe` on a tag
         build (-p:Version=… -p:AssemblyVersion=… -p:FileVersion=…); the Settings
         form prints AssemblyVersion, so that is the one that must be patched. -->
    <Version>0.0.0</Version>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>

    <!-- Both of these exist for the banner every log file opens with, which is
         the first thing read when someone sends one in. Neither is reachable
         from code any other way: there is no AssemblyInfo.cs to put them in, and
         the exe ships alone so there is no file beside it to read either.

         BuildDate is deliberately a *date* and not a timestamp. The generated
         AssemblyInfo.cs is rewritten whenever any of these values changes, and a
         value carrying the time of day changes on every single build — which
         would turn every no-op `dotnet build` into a real recompile of both
         projects. A date identifies a build well enough and costs one recompile
         a day. CI can pass -p:BuildDate= to pin it. -->
    <RepositoryUrl>https://github.com/o0Zz/PeripheralBatteryMonitor</RepositoryUrl>
    <BuildDate Condition="'$(BuildDate)' == ''">$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd"))</BuildDate>
  </PropertyGroup>

  <ItemGroup>
    <!-- RepositoryUrl is a NuGet packaging property: the SDK puts it in a .nuspec,
         not into the assembly. Neither it nor BuildDate reaches a custom attribute
         without being named here. -->
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
    <AssemblyMetadata Include="BuildDate" Value="$(BuildDate)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-time only. Supplies the net48 reference assemblies so the repo
         builds with any recent .NET SDK, with no Visual Studio and no targeting
         pack installed. Contributes nothing at runtime. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
