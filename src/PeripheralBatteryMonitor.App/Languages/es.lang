# ---- ventana de configuración ----
settings.title = Peripheral Battery Monitor
settings.group.general = General
settings.group.devices = Dispositivos e iconos

settings.startup = Iniciar la aplicación al arrancar
settings.startup.hint = Se inicia con Windows, directamente en el área de notificación. Desactivado de forma predeterminada.

settings.notifications = Activar las notificaciones
settings.notifications.hint = Muestra un globo una vez cada vez que un dispositivo baja al 20 % o menos, no en cada actualización mientras siga así.

settings.refresh = Intervalo de actualización:
settings.refresh.unit = min
settings.refresh.hint = Con qué frecuencia se consulta cada dispositivo supervisado. Entre 1 minuto y 24 horas.

settings.language = Idioma:
settings.language.auto = Igual que Windows
settings.language.hint = Se aplica de inmediato. Los nombres que comunica un dispositivo se mantienen tal como los escribe el dispositivo.

settings.autoDetect = Detectar automáticamente los dispositivos nuevos
settings.autoDetect.hint = Sigue buscando dispositivos Bluetooth recién emparejados. Si se desactiva, solo se supervisan los ya emparejados al inicio. Los adaptadores USB siempre se detectan.

settings.oneIconPerDevice = Mostrar un icono por dispositivo
settings.oneIconPerDevice.hint = Si se desactiva, un único icono muestra la carga más baja de todos los dispositivos y su información emergente los enumera uno a uno.

settings.hideUnknown = Ocultar los dispositivos con carga desconocida
settings.hideUnknown.hint = Algunos dispositivos no comunican ninguna batería a Windows. Si se activa, quedan fuera del área de notificación, de la información emergente y de la lista.

