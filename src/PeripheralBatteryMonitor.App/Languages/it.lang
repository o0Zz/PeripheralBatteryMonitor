# ---- finestra Impostazioni ----
settings.title = Peripheral Battery Monitor
settings.group.general = Generale
settings.group.devices = Dispositivi e icone

settings.startup = Avvia l'applicazione all'accensione
settings.startup.hint = Si avvia con Windows, direttamente nell'area di notifica. Disattivato per impostazione predefinita.

settings.notifications = Attiva le notifiche
settings.notifications.hint = Mostra un fumetto una volta ogni volta che un dispositivo scende al 20% o meno, non a ogni aggiornamento finché resta a quel livello.

settings.refresh = Intervallo di aggiornamento:
settings.refresh.unit = min
settings.refresh.hint = Ogni quanto viene interrogato ciascun dispositivo monitorato. Tra 1 minuto e 24 ore.

settings.language = Lingua:
settings.language.auto = Come Windows
settings.language.hint = Ha effetto immediato. I nomi comunicati da un dispositivo restano come li scrive il dispositivo.

settings.autoDetect = Rileva automaticamente i nuovi dispositivi
settings.autoDetect.hint = Continua a cercare nuovi dispositivi Bluetooth associati. Se disattivato, vengono monitorati solo quelli già associati all'avvio. I dongle USB vengono sempre rilevati.

settings.oneIconPerDevice = Mostra un'icona per dispositivo
settings.oneIconPerDevice.hint = Se disattivato, un'unica icona mostra la carica più bassa fra tutti i dispositivi e il suo suggerimento li elenca uno per uno.

settings.hideUnknown = Nascondi i dispositivi con carica sconosciuta
settings.hideUnknown.hint = Alcuni dispositivi non comunicano alcuna batteria a Windows. Se attivo, vengono esclusi dall'area di notifica, dal suggerimento e dall'elenco.

