@name = Français

app.name = Peripheral Battery Monitor

# ---- icône de la zone de notification ----
tray.refresh = Actualiser
tray.restartBluetooth = Redémarrer le Bluetooth
tray.openLog = Ouvrir le dossier du journal
tray.settings = Paramètres
tray.exit = Quitter

tray.device.known = {0} : {1} %
tray.device.unknown = {0} : ?
tray.noDevice = Aucun périphérique connecté
notify.lowBattery = Batterie FAIBLE sur « {0} » ({1} %) !

# {0} durée d'extinction de la radio, en secondes
notify.bluetoothRestart.started = Redémarrage du Bluetooth. La radio est éteinte pendant {0} secondes.
notify.bluetoothRestart.done = Bluetooth redémarré.
notify.bluetoothRestart.failed = Impossible de redémarrer le Bluetooth.\n{0}

# ---- fenêtre Paramètres ----
settings.title = Peripheral Battery Monitor
settings.group.general = Général
settings.group.devices = Périphériques et icônes

settings.startup = Lancer l'application au démarrage
settings.startup.hint = Démarre avec Windows, directement dans la zone de notification. Désactivé par défaut.

settings.notifications = Activer les notifications
settings.notifications.hint = Affiche une infobulle chaque fois qu'un périphérique passe à 20 % ou moins, et non à chaque actualisation tant qu'il y reste.

settings.refresh = Période d'actualisation :
settings.refresh.unit = min
settings.refresh.hint = Fréquence d'interrogation de chaque périphérique suivi. Entre 1 minute et 24 heures.

settings.language = Langue :
settings.language.auto = Comme Windows
settings.language.hint = Prend effet immédiatement. Les noms signalés par un périphérique restent tels qu'il les écrit.

settings.autoDetect = Détecter automatiquement les nouveaux périphériques
settings.autoDetect.hint = Continue à surveiller les nouveaux périphériques Bluetooth appairés. Si désactivé, seuls ceux déjà appairés au démarrage sont suivis. Les dongles USB sont toujours détectés.

settings.oneIconPerDevice = Une icône par périphérique
settings.oneIconPerDevice.hint = Si désactivé, une seule icône affiche le niveau le plus bas de tous les périphériques et son infobulle les énumère.

settings.hideUnknown = Masquer les périphériques dont la batterie est inconnue
settings.hideUnknown.hint = Certains périphériques ne signalent aucune batterie à Windows. Si activé, ils sont exclus de la zone de notification, de l'infobulle et de la liste.

