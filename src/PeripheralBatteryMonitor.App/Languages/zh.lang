# ---- 系统托盘 ----
tray.refresh = 刷新
tray.restartBluetooth = 重启蓝牙
tray.openLog = 打开日志文件夹
tray.settings = 设置
tray.exit = 退出

tray.device.known = {0}：{1}%
tray.device.unknown = {0}：未知
tray.noDevice = 未连接设备
notify.lowBattery = “{0}”的电量低（{1}%）！

# {0} 蓝牙关闭的秒数
notify.bluetoothRestart.started = 正在重启蓝牙，蓝牙将关闭 {0} 秒。
notify.bluetoothRestart.done = 蓝牙已重启。
notify.bluetoothRestart.failed = 无法重启蓝牙。\n{0}

# ---- 设置窗口 ----
settings.title = Peripheral Battery Monitor
settings.group.general = 常规
settings.group.devices = 设备与托盘图标

settings.startup = 开机时启动应用
settings.startup.hint = 随 Windows 启动并直接驻留系统托盘。默认关闭。

settings.notifications = 启用低电量通知
settings.notifications.hint = 每当设备电量降至 20% 或以下时显示一次气泡通知；电量持续处于该范围时，不会在每次刷新时重复提醒。

settings.refresh = 刷新间隔：
settings.refresh.unit = 分钟
settings.refresh.hint = 每隔多久轮询所有跟踪的设备。可设置为 1 分钟至 24 小时。

settings.language = 语言：
settings.language.auto = 跟随 Windows
settings.language.hint = 立即生效。设备上报的名称保持原样。

settings.autoDetect = 自动检测新设备
settings.autoDetect.hint = 持续监测新配对的蓝牙设备。关闭后，仅跟踪应用启动时已配对的设备；USB 接收器始终会被检测。

settings.oneIconPerDevice = 每台设备显示一个托盘图标
settings.oneIconPerDevice.hint = 关闭时只显示一个图标，展示所有设备中的最低电量；工具提示会列出各台设备。

settings.hideUnknown = 隐藏电量未知的设备
settings.hideUnknown.hint = 部分设备不会向 Windows 上报电量。启用后，这些设备将不会出现在托盘、工具提示和设备列表中。

